<Window x:Class="PrintCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintCalc Pro" Height="760" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#333333" TextElement.Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- левое меню -->
        <StackPanel Grid.Column="0" Background="#424242">
            <TextBlock Text="PrintCalc" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,100,0,0" />
            <TextBlock Text="PRO EDITION" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,50" />

            <Button Content="Калькулятор" Click="BtnCalc_Click"     Style="{StaticResource MaterialDesignFlatButton}" Height="45" />
            <Button Content="Пластики"    Click="BtnPlastics_Click" Style="{StaticResource MaterialDesignFlatButton}" Height="45" />
            <Button Content="Заказы"      Click="BtnOrders_Click"   Style="{StaticResource MaterialDesignFlatButton}" Height="45" />
            <Button Content="Итоги"       Click="BtnSummary_Click"  Style="{StaticResource MaterialDesignFlatButton}" Height="45" />
        </StackPanel>

        <!-- сюда подставляются экраны -->
        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>
