<UserControl x:Class="PrintCalc.Views.PlasticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:Card Background="#424242" Padding="24" Margin="40" VerticalAlignment="Top" MaxWidth="700">
        <StackPanel>
            <TextBlock Text="Пластики" FontSize="22" Margin="0,0,0,12" />

            <DataGrid x:Name="GridPlastics" AutoGenerateColumns="False" CanUserAddRows="False" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Цена за кг (₽)" Binding="{Binding PricePerKg}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="BtnSavePlastics" Content="СОХРАНИТЬ ИЗМЕНЕНИЯ" Height="40" Margin="0,16,0,0" />

            <TextBlock Text="Новый пластик" FontSize="16" Margin="0,24,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtNewName"  materialDesign:HintAssist.Hint="Название" Width="250" Margin="0,8,16,8" />
                <TextBox x:Name="TxtNewPrice" materialDesign:HintAssist.Hint="Цена за кг (₽)" Width="150" Margin="0,8,16,8" />
                <Button  x:Name="BtnAddPlastic" Content="ДОБАВИТЬ" Height="40" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>
