<UserControl x:Class="PrintCalc.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <materialDesign:Card Background="#424242" Padding="24" Margin="40" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="Заказы" FontSize="22" Margin="0,0,0,12" />

            <DataGrid x:Name="GridOrders" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" Height="450">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"          Binding="{Binding Date}" />
                    <DataGridTextColumn Header="Клиент"        Binding="{Binding Client}" Width="*" />
                    <DataGridTextColumn Header="Пластик"       Binding="{Binding PlasticName}" />
                    <DataGridTextColumn Header="Себестоимость" Binding="{Binding Cost}" />
                    <DataGridTextColumn Header="Цена"          Binding="{Binding Price}" />
                    <DataGridTextColumn Header="Прибыль"       Binding="{Binding Profit}" />
                    <DataGridTextColumn Header="Статус"        Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="BtnPaid"   Content="ОТМЕТИТЬ ОПЛАЧЕННЫМ" Height="40" Margin="0,0,16,0" />
                <Button x:Name="BtnDelete" Content="УДАЛИТЬ" Height="40" />
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>
